{
  "manifest_version": 3,
  "name": "ReelSnap Web",
  "version": "1.0.1",
  "description": "Capture frames from TikTok, Instagram, Facebook, Snapchat Spotlight and YouTube Shorts: burst or auto-loop through reels. Offline.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "downloads", "activeTab"],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.snapchat.com/*",
    "*://*.youtube.com/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.snapchat.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/content/util.js",
        "src/content/sites.js",
        "src/content/video.js",
        "src/content/capture.js",
        "src/content/runner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ReelSnap Web",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
